generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FileCache {
  hash       String   @id
  bytes      Int
  accessedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model KeyValueCache {
  key       String   @id
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CleanupMode {
  NONE
  DJ_ONLY
  ALL_BOT_MESSAGES
}

model Setting {
  guildId                             String      @id
  playlistLimit                       Int         @default(50)
  secondsToWaitAfterQueueEmpties      Int         @default(30)
  leaveIfNoListeners                  Boolean     @default(true)
  queueAddResponseEphemeral           Boolean     @default(false)
  autoAnnounceNextSong                Boolean     @default(false)
  defaultVolume                       Int         @default(100)
  defaultQueuePageSize                Int         @default(10)
  turnDownVolumeWhenPeopleSpeak       Boolean     @default(false)
  turnDownVolumeWhenPeopleSpeakTarget Int         @default(20)
  cleanupMode                         CleanupMode @default(NONE)
  ephemeralDelaySeconds               Int         @default(45)
  cleanupOnSessionEnd                 Boolean     @default(true)
  statsDigestEnabled                  Boolean     @default(false)
  statsDigestCadenceDays              Int         @default(7)
  statsWebhookUrl                     String?
  statsDigestDmOwner                  Boolean     @default(false)
  statsDigestLastSentAt               DateTime?
  djChannelId                         String?
  createdAt                           DateTime    @default(now())
  updatedAt                           DateTime    @updatedAt
}

model FavoriteQuery {
  id        Int      @id @default(autoincrement())
  guildId   String
  authorId  String
  name      String
  query     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, name])
}

model DjSetting {
  guildId               String   @id
  enabled               Boolean  @default(false)
  minQueueSize          Int      @default(2)   // auto-fill trigger threshold
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// One row per track actually played in a guild, keyed by YouTube
// video ID (song.url in Muse's SongMetadata) since that's the only
// stable identifier Muse already has for a track — there is no
// separate "Track" entity in Muse today.
model PlayHistory {
  id          Int      @id @default(autoincrement())
  guildId     String
  youtubeId   String   // song.url
  title       String
  artist      String
  requestedBy String?  // discord user id; null if auto-queued by DJ
  wasDjPick   Boolean  @default(false)
  skipped     Boolean  @default(false)
  playedAt    DateTime @default(now())
  msPlayed    Int?     // actual listened duration in ms; null if unknown
  durationMs  Int?     // the track's total length in ms, for completion %

  @@index([guildId, playedAt])
  @@index([youtubeId])
  @@index([requestedBy, playedAt])

  listeners PlayHistoryListener[]
}

enum ListenerRole {
  REQUESTER
  LISTENER
}

// Snapshot of who was actually in the voice channel when a track STARTED
// (see player.ts's onAudioPlayerIdle -> recordListeners call). One row per
// person present per play, so Wrapped can credit passive listeners, not
// just whoever typed the command -- that's the whole point of this table
// existing separately from PlayHistory, which stays one-row-per-play so
// DjRecommender/MessageCleanup/etc keep their existing "one row = one play"
// assumptions intact.
//
// ponytail: doesn't track mid-track join/leave -- everyone present at track
// start is credited the track's full msPlayed, even if they left early.
// Upgrade path: record each listener's own join/leave timestamps if that
// ever matters enough to justify the added complexity.
model PlayHistoryListener {
  id            Int          @id @default(autoincrement())
  playHistoryId Int
  playHistory   PlayHistory  @relation(fields: [playHistoryId], references: [id])
  guildId       String
  userId        String
  role          ListenerRole

  @@unique([playHistoryId, userId])
  @@index([guildId, userId])
}

// Precomputed co-occurrence, refreshed periodically rather than
// computed live on every recommendation (see scripts/refresh-dj-cooccurrence.ts).
// Scoped per-guild -- co-occurrence pairs from one guild's listening
// history must never leak into another guild's recommendations.
model TrackCooccurrence {
  guildId     String
  youtubeIdA  String
  youtubeIdB  String
  score       Float    @default(0)
  sampleSize  Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([guildId, youtubeIdA, youtubeIdB])
  @@index([guildId, youtubeIdA, score])
}

// Caches Spotify genre lookups by artist name, since YouTube gives
// no genre data at all. Looked up once per artist (not per track,
// since Spotify's genre data is attached to artists, not tracks),
// cached indefinitely — genres don't meaningfully change often enough
// to bother expiring this.
model ArtistGenreCache {
  artist    String   @id
  genres    String[] // Postgres native array type
  fetchedAt DateTime @default(now())
}
